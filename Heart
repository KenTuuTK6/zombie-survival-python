import turtle
import math

t = turtle.Turtle()
t.speed(0)
t.color("red")
turtle.bgcolor("black")

def corazon(n):
    x = 16 * math.sin(n) ** 3
    y = 13 * math.cos(n) - 5 * math.cos(2*n) - 2 * math.cos(3*n) - math.cos(4*n)
    return x, y

for i in range(1, 15):
    t.penup()
    t.goto(0, 0)
    t.pendown()

    for n in range(0, 100, 2):
        x, y = corazon(n / 10)
        t.goto(x * i, y * i)


t.penup()
t.goto(-45, -10)
t.color("white")
t.write("I LOVE YOU", font=("Arial", 18, "bold"))

t.hideturtle()
turtle.done()

t.hideturtle()
turtle.done()